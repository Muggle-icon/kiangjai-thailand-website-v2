  "narrative": {
    "northStar": "Everyday Cyan, Real Product",
    "overview": "A coherent cyan campaign pairs original generated still-life art with the untouched Kiangjai App home. MoneyThunder informs campaign completeness and chapter rhythm; reviewed content and original identity remain the product authority. Native HTML supplies all webpage labels, controls and interactions. Art is conceptual, not customer photography or business evidence.",
    "keyCharacteristics": [
      "Transparent generated work-life still life behind one complete real App home.",
      "Coordinated paper-and-canvas feature art with a clear primary/secondary hierarchy.",
      "Company facts and quiet reading areas instead of repeated marketing copy.",
      "Natural Thai typography and consistent native interactions."
    ],
    "rules": [
      {
        "name": "Chapter Rhythm",
        "body": "Use cyan for the campaign and final action, ink for navigation and primary online feature, neutral reading areas for process and help, and white for company facts.",
        "section": "colors"
      },
      {
        "name": "Thai Integrity",
        "body": "Preserve natural Thai wrapping and zero Thai letter spacing; numeric tracking does not apply to Thai text.",
        "section": "typography"
      },
      {
        "name": "Image Integrity",
        "body": "Generated assets frame the untouched App image, never replace or obscure it; keep complete natural aspect ratios.",
        "section": "assets"
      }
    ],
    "dos": [
      "Use original master Logo and complete real App screenshots.",
      "Keep generated still life conceptual and subordinate to reviewed business truth.",
      "Retain real pending download/legal states and keyboard access.",
      "Verify each required viewport with actual rendered screenshots."
    ],
    "donts": [
      "Do not generate people photos, fake App interfaces, coins or approval evidence.",
      "Do not crop phones into half-screen decoration or paint over product content.",
      "Do not invent financial claims, store links, payment QR codes or license resources.",
      "Do not treat metadata or previous-round QA as current test results."
